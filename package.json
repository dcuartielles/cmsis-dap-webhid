{
  "name": "cmsis-dap-webhid",
  "version": "0.2.0",
  "description": "Use CMSIS-DAP debug probes from a web page over WebHID: the transport dapjs lacks, plus Cortex-M debugging and flash programming",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./transport": "./src/transport.js",
    "./debug": "./src/debug.js",
    "./flm": "./src/flm.js",
    "./flash": "./src/flash.js",
    "./pack": "./src/pack.js",
    "./hex": "./src/hex.js"
  },
  "files": [
    "src",
    "tools",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "cmsis-dap",
    "webhid",
    "dapjs",
    "swd",
    "cortex-m",
    "arm",
    "debugger",
    "flash",
    "flm",
    "intel-hex",
    "embedded",
    "microcontroller",
    "browser",
    "arduino"
  ],
  "peerDependencies": {
    "dapjs": "^2.3.0"
  },
  "peerDependenciesMeta": {
    "dapjs": {
      "optional": true
    }
  },
  "author": "David J. Cuartielles Ruiz",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcuartielles/cmsis-dap-webhid.git"
  },
  "bugs": {
    "url": "https://github.com/dcuartielles/cmsis-dap-webhid/issues"
  },
  "homepage": "https://github.com/dcuartielles/cmsis-dap-webhid#readme",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "bin": {
    "fetch-flm": "tools/fetch-flm.mjs"
  },
  "scripts": {
    "test": "node --test test/"
  }
}
